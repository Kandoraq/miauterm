#!/bin/bash
set -e

case "$#" in
    0) set -- root ;;
    1)
        case "$1" in
            -|--login|-l) set -- root ;;
        esac
        ;;
    2)
        case "$1" in
            -|--login|-l) set -- "$2" ;;
            *) printf 'Usage: su [-|--login|-l] [USER]\n' >&2; exit 2 ;;
        esac
        ;;
    *) printf 'Usage: su [-|--login|-l] [USER]\n' >&2; exit 2 ;;
esac
exec miauterm-cmd run su "$1"
